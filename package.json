    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
